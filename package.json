{
  "name": "codeblox",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Agent-driven, block-based build engine on Three.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gen:config": "node scripts/js/gen-config.mjs",
    "postinstall": "node scripts/js/gen-config.mjs",
    "predev": "npm run gen:config",
    "dev": "vite",
    "preserve": "npm run gen:config",
    "serve": "node apps/server/index.js",
    "dev:stop": "node scripts/js/dev-stop.mjs",
    "dev:list": "node scripts/js/dev-stop.mjs --list",
    "prestart": "npm run gen:config",
    "start": "concurrently -k -n server,web -c green,cyan \"node apps/server/index.js\" \"vite\"",
    "prebuild": "npm run gen:config",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run gen:config",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cli": "cd clients/codeblox && go build -o bin/ .",
    "test:cli": "cd clients/codeblox && go test ./...",
    "test:e2e": "cd clients/codeblox && go test -tags=integration ./tests/"
  },
  "dependencies": {
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "js-yaml": "^5.2.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
